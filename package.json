{
  "name": "lenggujian-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "visual:capture": "node scripts/capture-visuals.mjs",
    "links:check": "node scripts/check-links.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "audit:projects": "node scripts/audit-projects.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm privacy:scan"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "lighthouse": "^13.4.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.15.1"
}
